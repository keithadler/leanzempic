cabal-version:      2.4
name:               zempic-runtime
version:            0.1.0
synopsis:           Haskell runtime for code generated by leanzempic (Lean 4 to GHC)
description:
  Support modules that the Haskell emitted by leanzempic imports: Nat as Word (fast path) and as
  Natural (exact), fixed-width integers, fusible list combinators, persistent arrays and
  shared-buffer strings. Not intended for direct use.
license:            Apache-2.0
author:             Keith Adler
build-type:         Simple

library
  hs-source-dirs:   .
  exposed-modules:
    Zempic.Runtime
    Zempic.Nat.Word
    Zempic.Nat.Exact
    Zempic.List
    Zempic.UInt
    Zempic.Arr
    Zempic.Str
    Zempic.Auto
    Zempic.Prims
  build-depends:    base >=4.18 && <5, array, bytestring, text
  default-language: Haskell2010
  ghc-options:      -O2 -Wall -Wno-unused-imports -Wno-name-shadowing -Wno-unused-matches
