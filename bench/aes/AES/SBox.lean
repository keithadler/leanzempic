/-- `SBOX`, FIPS-197 §5.1.1. -/
def sbox (b : Byte) : Byte := sboxTable.getD b.toNat 0

/-- `INVSBOX`, FIPS-197 §5.3.2. -/
def invSbox (b : Byte) : Byte := invSboxTable.getD b.toNat 0

/-- Bit `i` of a byte, counting from the least significant, indices taken mod 8 as FIPS-197 eq. (5.1)
does. -/
def bit (b : Byte) (i : Nat) : Bool := b.toNat.testBit (i % 8)

/-- The byte whose bit `i` is `f i`. -/
def ofBits (f : Nat → Bool) : Byte := (go 8).toUInt8
where
  go : Nat → Nat
    | 0 => 0
    | n + 1 => go n + if f n then 2 ^ n else 0

/-- The affine transformation of FIPS-197 eq. (5.1), bit by bit:
`b'ᵢ = bᵢ ⊕ b₍ᵢ₊₄₎ ⊕ b₍ᵢ₊₅₎ ⊕ b₍ᵢ₊₆₎ ⊕ b₍ᵢ₊₇₎ ⊕ cᵢ` with `c = {63}`. -/
def affine (b : Byte) : Byte :=
  ofBits fun i => bit b i ^^ bit b (i + 4) ^^ bit b (i + 5) ^^ bit b (i + 6) ^^ bit b (i + 7) ^^ bit 0x63 i

/-- The inverse affine transformation of FIPS-197 eq. (5.16):
`b'ᵢ = b₍ᵢ₊₂₎ ⊕ b₍ᵢ₊₅₎ ⊕ b₍ᵢ₊₇₎ ⊕ dᵢ` with `d = {05}`. -/
def invAffine (b : Byte) : Byte :=
  ofBits fun i => bit b (i + 2) ^^ bit b (i + 5) ^^ bit b (i + 7) ^^ bit 0x05 i

/-- Table 4 is what §5.1.1 says it is: the inverse in GF(2⁸), then the affine map. -/
theorem sbox_eq_affine_inv (b : Byte) : sbox b = affine (inv b) := by
  have : allBytes (fun b => sbox b == affine (inv b)) = true := by decide +kernel
  simpa using allBytes_spec this b

/-- Table 6 is what §5.3.2 says it is: the inverse affine map, then the inverse in GF(2⁸). -/
theorem invSbox_eq_inv_invAffine (b : Byte) : invSbox b = inv (invAffine b) := by
  have : allBytes (fun b => invSbox b == inv (invAffine b)) = true := by decide +kernel
  simpa using allBytes_spec this b

theorem invSbox_sbox (b : Byte) : invSbox (sbox b) = b := by
  have : allBytes (fun b => invSbox (sbox b) == b) = true := by decide +kernel
  simpa using allBytes_spec this b

theorem sbox_invSbox (b : Byte) : sbox (invSbox b) = b := by
  have : allBytes (fun b => sbox (invSbox b) == b) = true := by decide +kernel
  simpa using allBytes_spec this b

theorem sbox_injective {a b : Byte} (h : sbox a = sbox b) : a = b := by
  rw [← invSbox_sbox a, h, invSbox_sbox]

/-- The S-box has no fixed point, and no "opposite" fixed point: the constant `{63}` was chosen for
this (*The Design of Rijndael*, §3.4.1). -/
theorem sbox_ne_self (b : Byte) : sbox b ≠ b ∧ sbox b ≠ ~~~b := by
  have : allBytes (fun b => sbox b != b && sbox b != ~~~b) = true := by decide +kernel
  simpa using allBytes_spec this b

end AES
